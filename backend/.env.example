NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# In development, localhost and private-LAN frontend URLs are also accepted on
# any valid port. Production accepts only the exact CLIENT_ORIGINS entries.

# Find these values in the existing Supabase project settings.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Optional in development: without SMTP, OTPs are printed to the backend console.
# Required in production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
# For Gmail, use a 16-character Google App Password, not the account password.
SMTP_PASSWORD=your-google-app-password
SMTP_FROM="SAFAR <your-sender@gmail.com>"

# Generate a random value of at least 32 characters for production. Development
# generates an ephemeral process-local value when this is omitted.
OTP_HASH_SECRET=replace-with-a-long-random-secret
OTP_EXPIRES_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5

# Used only by: npm run admin:create
BOOTSTRAP_ADMIN_EMAIL=transport.authority@cuet.ac.bd
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_ADMIN_NAME=Transport Authority
BOOTSTRAP_ADMIN_EMPLOYEE_ID=ADM-2026-0001
